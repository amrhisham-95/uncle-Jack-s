            app:layout_constraintTop_toTopOf="@+id/guideline117" />

        <TextView
            android:id="@+id/totalAmountCheckout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fontFamily="@font/poppins_bold"
